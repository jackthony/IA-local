# Perfil Jev alojado (TypeSafe): API propia (POST /v1/systemone), no OpenAI-compatible. Docs: https://docs.typesafe.ai/api.md
# Copia a un archivo local NO versionado, rellena y carga: set -a; source ~/mi-typesafe.env; set +a
TYPESAFE_API_KEY=<TU-CLAVE-DE-TYPESAFE>   # nunca a git; la consola está en https://console.typesafe.ai/
# Opcionales (valores por defecto):
# TYPESAFE_MODEL=jev-latest
# TYPESAFE_URL=https://api.typesafe.ai/v1/systemone
# Precios de TU cuenta en USD por 1M de tokens. Referencia pública: entrada 0.042, salida 0 (verifica tu plan).
PRECIO_ENTRADA_USD_1M=
PRECIO_SALIDA_USD_1M=
# Topes de gasto de la grabación (ver evals/README.md). Con ~70 llamadas de ~400 tokens son centavos.
# GRABAR_MAX_LLAMADAS=70
# GRABAR_MAX_TOKENS=60000
# GRABAR_MAX_USD=0.05
