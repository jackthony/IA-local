# Perfil Azure OpenAI: mismo cliente OpenAI-compatible, solo cambian variables de entorno (endpoint /openai/v1/).
# Copia a un archivo local NO versionado, rellena y carga: set -a; source mi-azure.env; set +a
# Jev necesita logprobs: usa un despliegue de chat NO razonador (p. ej. gpt-4o-mini / gpt-4.1-mini).
# Los modelos de razonamiento (o-series, gpt-5) rechazan logprobs/temperature y max_tokens.
LLM_BASE_URL=https://<TU-RECURSO>.openai.azure.com/openai/v1/
LLM_MODEL=<NOMBRE-DE-TU-DESPLIEGUE>
LLM_API_KEY=<CLAVE-DEL-RECURSO>   # nunca a git; mejor desde el almacén de secretos
# Precios de TU contrato en USD por 1M de tokens (cambian: no se asumen). Sin ellos el costo sale "sin precios".
PRECIO_ENTRADA_USD_1M=
PRECIO_SALIDA_USD_1M=
