# Perfil DeepSeek: mismo cliente OpenAI-compatible, solo cambian variables de entorno.
# Copia a un archivo local NO versionado, rellena y carga: set -a; source ~/mi-deepseek.env; set +a
# Jev necesita logprobs: usa el modelo de chat (deepseek-chat). El modo de razonamiento no los devuelve.
# Si la API rechaza logprobs o devuelve la lista vacía, `--grabar` falla: no se inventan predicciones.
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=<TU-CLAVE-DE-DEEPSEEK>   # nunca a git; mejor desde el almacén de secretos
# Precios de TU cuenta en USD por 1M de tokens (cambian: no se asumen). Sin ellos el costo sale "sin precios".
PRECIO_ENTRADA_USD_1M=
PRECIO_SALIDA_USD_1M=
